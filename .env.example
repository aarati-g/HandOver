# -----------------------------------------------------------------------------
# Handover Monorepo Environment Variables Template
# Copy this file to .env and configure values as needed.
# -----------------------------------------------------------------------------

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/handover
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=handover
POSTGRES_PORT=5432

# AI Service Configuration (Replaceable Provider Abstraction)
# Available options: openai, anthropic, ollama, local
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LOCAL_LLM_URL=http://localhost:11434

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
