# -----------------------------------------------------------------------------
# Handover Monorepo Environment Variables Template
# Copy this file to .env and configure values as needed.
# -----------------------------------------------------------------------------

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS / Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL-ready with local SQLite fallback for immediate demo)
DATABASE_URL=sqlite+aiosqlite:///./handover.db
# For PostgreSQL (Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/handover

# AI Configuration (Official Google GenAI SDK with swappable abstraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_FALLBACK_ENABLED=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
